{
  "name": "@tdc/admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,ui \"tsx watch --env-file=../../.env src/server.ts\" \"vite --config client/vite.config.ts\"",
    "build": "tsc -p tsconfig.json && vite build --config client/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "node --test dist/server/auth.test.js dist/server/workflow.test.js",
    "start": "node dist/server/server.js"
  },
  "dependencies": {
    "@tdc/core": "*",
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@azure/storage-blob": "^12.26.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "hls.js": "^1.5.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
