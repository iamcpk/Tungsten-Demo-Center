# Local development. Copy to .env and adjust. Never commit real values.
# With no COSMOS_ENDPOINT / STORAGE_ACCOUNT the apps use a JSON store and files in ./data.
DATA_MODE=local
LOCAL_DATA_DIR=../../data
MEDIA_BASE_URL=http://localhost:5173/media
PUBLIC_SITE_URL=http://localhost:5173

# Admin portal only: bypasses Entra sign-in. Refused automatically when running in Azure.
AUTH_MODE=dev

# To work against a real Azure environment instead (uses your `az login` identity, which needs data roles):
# DATA_MODE=cosmos
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# STORAGE_ACCOUNT=<storage account name>
# MEDIA_BASE_URL=https://<front door endpoint>.azurefd.net
